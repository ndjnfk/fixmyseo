{
  "name": "fixmyseo-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --test test/unit.*.test.js test/ssrf.test.js test/crawler.test.js test/ai.test.js",
    "test:integration": "node --test --test-concurrency=1 test/int.*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "robots-parser": "^3.0.1",
    "undici": "^6.29.1",
    "zod": "^3.23.8"
  }
}
