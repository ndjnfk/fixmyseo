# Local development. Copy to .env (git-ignored). Docker Compose reads MYSQL_ROOT_PASSWORD etc. from here too.
NODE_ENV=development
MYSQL_ROOT_PASSWORD=rootpass
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=seo
REDIS_URL=redis://127.0.0.1:6380

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENC_KEY=

WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Local LLM (Ollama). AI_ENABLED=0 switches every AI endpoint to 503 ai_disabled.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
AI_ENABLED=1

# Google Search Console OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/google/callback

# Billing: "test" provider activates plans immediately (no gateway). Webhook secret for HMAC verification.
BILLING_PROVIDER=test
BILLING_WEBHOOK_SECRET=

# Crawler
CRAWL_MAX_PAGES_DEFAULT=200
CRAWL_CONCURRENCY=4
# never 1 in production; only for the test fixture site
ALLOW_PRIVATE_HOSTS=0
