# Server par: cp .env.production.example .env   phir saari values bharo.
# Random values ke liye: openssl rand -hex 32

# Tool ka poora URL, https ke saath, aakhir mein slash NAHI. Sub-path bhi chalega.
APP_URL=https://trustrideser.com/fixmyseo

# MySQL 8 (MongoDB nahi)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fixmyseo
DB_PASSWORD=
DB_NAME=fixmyseo

JWT_SECRET=
INTERNAL_KEY=
# 64 hex characters (openssl rand -hex 32). Ek baar set karke kabhi mat badlo, warna saved Google login kaam nahi karega.
ENC_KEY=

# Google Cloud OAuth (Search Console). Redirect URI = APP_URL + /api/google/callback
#   https://trustrideser.com/fixmyseo/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: AI keyword research
ANTHROPIC_API_KEY=

# Ports (sirf tab badlo jab server par ye pehle se kisi aur app ke paas hon; nginx.conf mein bhi badalna)
API_PORT=4100
INTEL_PORT=8100
WEB_PORT=3100
