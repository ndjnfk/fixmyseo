# Server: cp .env.production.example .env  then fill every value. Random values: openssl rand -hex 32
NODE_ENV=production

# Full public URL of the app, https, no trailing slash. A sub-path works (nginx snippet in deploy/).
APP_URL=https://trustrideser.com/fixmyseo

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fixmyseo
DB_PASSWORD=
DB_NAME=fixmyseo

# Redis 7 (must run with maxmemory-policy noeviction for BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# >= 32 random chars
JWT_SECRET=
# 64 hex chars (openssl rand -hex 32). Set once; changing it invalidates saved Google connections.
ENC_KEY=

# Local LLM. AI_ENABLED=0 turns every AI endpoint into 503 ai_disabled while everything else keeps working.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
AI_ENABLED=1
AI_TIMEOUT_MS=180000

# Google Cloud OAuth (Search Console). Redirect URI = APP_URL + /api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing. "test" = owner can switch plans without payment. For a real gateway set its name and the webhook secret;
# the gateway must POST signed events (HMAC-SHA256 of the raw body, header x-webhook-signature) to /api/billing/webhook/<provider>.
BILLING_PROVIDER=test
BILLING_WEBHOOK_SECRET=

# Crawler limits
CRAWL_MAX_PAGES_DEFAULT=200
CRAWL_HARD_MAX_PAGES=2000
CRAWL_CONCURRENCY=4
WORKER_CONCURRENCY_CRAWL=2
WORKER_CONCURRENCY_AI=1

# Ports (change only if taken; keep deploy/nginx.conf in sync)
API_PORT=4100
WEB_PORT=3100
